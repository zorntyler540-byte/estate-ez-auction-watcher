# Copy to .env for local overrides. Never commit .env.
# CTBids / Estate-Ez passwords and JWTs are not set here — they stay on
# this PC (Windows DPAPI or the Mac Keychain) after you sign in.

# Estate-Ez cataloging website API (this Watcher posts engagement snapshots
# and pulls the CT Seller session from the signed-in Estate-Ez account).
# Uncomment to override the production default.
# ESTATE_EZ_API_BASE=https://caringtransitions-ai-production.up.railway.app

# Send `complete` on engagement snapshots (on by default). Set to 0 to disable, or
# set "engagement_send_complete": false in %LOCALAPPDATA%\SaleWatcher\watcher_config.json.
# ESTATE_EZ_SEND_COMPLETE=0

# Optional path to Chrome/Chromium for HTML-to-PDF report export.
# SALE_REPORT_BROWSER=
# SALE_WATCHER_BROWSER=
